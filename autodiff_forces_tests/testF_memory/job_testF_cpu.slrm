#!/bin/bash
#SBATCH --job-name=testF_cpu
#SBATCH --partition=zen3_1024
#SBATCH --qos=p71334_1024
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --exclusive
#SBATCH --time=08:00:00
#SBATCH --output=slurm_%j.out
# Test F on one VSC5 CPU node: memory and time of the derivative (plain run, forward mode, reverse mode, reverse mode
# with checkpointing) against window length, walkers and system size. Every configuration is a separate process with
# one thread on its own physical core (64 at a time). First the exactness tests of the derivative.
source ~/.venv/vsc5_venv/bin/activate
R=/gpfs/data/fs71334/sajad/autodiff_forces
export VAFPY_SRC=$R/code/vafpy_v3 AFQMC_DATA=$R/data JAX_PLATFORMS=cpu NREP=2
export OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1
export XLA_FLAGS="--xla_cpu_multi_thread_eigen=false intra_op_parallelism_threads=1"
cd $R/testF_memory
echo "$(date) start on $(hostname), python $(which python), jax $(python -c 'import jax; print(jax.__version__)')"
(cd $VAFPY_SRC && python -m pytest -q test_autodiff_forces.py -p no:cacheprovider) > pytest_autodiff.log 2>&1
echo "$(date) pytest rc=$? $(tail -1 pytest_autodiff.log)"
NSLOT=64
# one logical CPU per physical core, from the CPUs this job may use
CORES=($(python - <<'PY'
import os, subprocess
allowed = os.sched_getaffinity(0)
seen, out = set(), []
for line in subprocess.run(["lscpu", "-p=CPU,CORE"], capture_output=True, text=True).stdout.splitlines():
    if line.startswith("#"): continue
    cpu, core = map(int, line.split(","))
    if cpu in allowed and core not in seen:
        seen.add(core); out.append(cpu)
print(*out[:64])
PY
))
echo "$(date) ${#CORES[@]} physical cores used: ${CORES[*]}"
for s in $(seq 0 $((NSLOT - 1))); do
  ( awk -v s=$s -v n=$NSLOT 'NR % n == s' configs_cpu.txt | while read -r cfg; do
      taskset -c ${CORES[$s]} python -u run_mem.py $cfg >> results_cpu_$s.jsonl 2>> errors_cpu_$s.log \
        || echo "{\"failed\": \"$cfg\"}" >> results_cpu_$s.jsonl
    done ) &
done
wait
cat results_cpu_*.jsonl > results_cpu.jsonl
echo "$(date) TESTF_CPU_DONE $(grep -c failed results_cpu.jsonl) failed"
